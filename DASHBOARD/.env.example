# Copy to .env (same folder as docker-compose.yml) and fill in. .env is gitignored.
GEMINI_API_KEY=
# Serving Layer graph (Section 6.x). Leave unset locally to use the SERVING_LAYER Neo4j container;
# on Railway set these to the Neo4j AuraDB instance.
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# Optional overrides
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_CHAT_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
