# Copy to .env (same folder as docker-compose.yml) and fill in. .env is gitignored.
GEMINI_API_KEY=

# Neo4j serving layer. MySQL remains the source of truth.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j_dev_only
NEO4J_DATABASE=neo4j
# Must be changed together with GEMINI_EMBED_DIM if a different embedding size is used.
NEO4J_VECTOR_INDEX=search_chunk_embedding

# Optional overrides
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_CHAT_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
